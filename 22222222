#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct L {
        char m[10];
        char n[10];
        struct L *next;
};
struct L* list(){
    struct L *h=(struct L*)malloc(sizeof(struct L));
    h->next=NULL;
    return h;
}
void insert(struct L *h,char *m,char *n){
    struct L *p=h;
    while(p->next!=NULL){
        p=p->next;
    }
    struct L *q=(struct L*)malloc(sizeof(struct L));
    strcpy(q->m,m);
    strcpy(q->n,n);
    q->next=NULL;
    p->next=q;
}

void delete(struct L *h,char *m){
    struct L *p=h;
    while(p->next!=NULL){
        if(strcmp(p->next->m,m)==0){
            struct L *q=p->next;
            p->next=q->next;
            free(q);
            break;
        }
        p=p->next;
    }
}

void reverse(struct L *h){
    struct L *p=h->next,*q=NULL,*r=NULL;
    while(p!=NULL){
        r=p->next;
        p->next=q;
        q=p;
        p=r;
    }
    h->next=q;
}

void merge(struct L *h1,struct L *h2){
    struct L *p=h1->next,*q=h2->next,*r=h1;
    while(p!=NULL && q!=NULL){
        if(strcmp(p->m,q->m)<0){
            r->next=p;
            r=p;
            p=p->next;
        }
        else{
            r->next=q;
            r=q;
            q=q->next;
        }
    }
    if(p!=NULL) r->next=p;
    if(q!=NULL) r->next=q;
}








void print(struct L *h){
    struct L *p=h->next;
    while(p!=NULL){
        printf("%s %s\n",p->m,p->n);
        p=p->next;
    }
}


int main(){
    struct L *head=list();
    char s[100];
    char m[10],n[10];
    printf("输入学号姓名(回车结束):");
    while(fgets(s,sizeof(s),stdin)!=NULL){
        if(s[0]=='\n') 
            break;
        sscanf(s,"%s %s",m,n);
        insert(head,m,n);
    }
    while(1){
        printf("功能选择(1.尾插 2.按学号删除 3.原地逆置 4.有序合并 5.销毁并退出):");
        int a;
        scanf("%d",&a);
        if(a==1){
            printf("输入学号姓名(回车结束):");
            while(fgets(s,sizeof(s),stdin)!=NULL){
                if(s[0]=='\n') 
                    break;
                sscanf(s,"%s %s",m,n);
                insert(head,m,n);
            }
            print(head);
        }
        else if(a==2){
            printf("输入要删除的学号:");
            scanf("%s",m);
            delete(head,m);
            print(head);
        }
        else if(a==3){
            reverse(head);           
            print(head);   
        }
        else if(a==4){
            printf("输入要合并的链表(学号 姓名,回车结束):");
            char s2[100];
            struct L *head2=list();
            while(fgets(s2,sizeof(s2),stdin)!=NULL){
                if(s2[0]=='\n') 
                    break;
                sscanf(s2,"%s %s",m,n);
                insert(head2,m,n);
            }
            merge(head,head2);
            print(head);
        }
        else if(a==5){
            struct L *p=head,*q=NULL;
            while(p!=NULL){
                q=p->next;
                free(p);
                p=q;
            }
            break;
        }
    }
    return 0;
}
